{
  "manifest_version": 3,
  "name": "Ketch",
  "version": "0.1.0",
  "description": "Send downloads, links and magnet links to Ketch on this computer or a remote server.",
  "homepage_url": "https://github.com/linroid/Ketch",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Ketch",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["contextMenus", "cookies", "downloads", "notifications", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/magnet.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}

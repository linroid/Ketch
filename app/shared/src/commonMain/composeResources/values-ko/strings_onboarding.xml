  <string name="onboarding_files_body">Ketch는 다운로드한 파일을 파일 앱에서 열고, 공유하고, 옮길 수 있는 곳에 저장합니다.</string>
  <string name="onboarding_files_path">나의 %1$s › Ketch › Downloads</string>

  <string name="onboarding_folder_title">다운로드를 어디에&#160;저장할까요?</string>
  <string name="onboarding_folder_body">다른 앱은 Ketch 전용 폴더를 열 수 없습니다. Download에 저장하면 어느 앱에서나 파일을 볼 수 있습니다.</string>
  <string name="onboarding_folder_use_download">Download 폴더 사용</string>
  <string name="onboarding_folder_not_now">나중에</string>
  <string name="onboarding_folder_choose_another">다른 폴더 선택</string>

  <string name="onboarding_folder_error">이 폴더를 사용할 수 없습니다. 다른 폴더를 선택하세요.</string>

  <string name="onboarding_use_title">이 기기에서 Ketch를 어떻게&#160;사용할까요?</string>
  <string name="onboarding_use_body">시작할 방법을 하나 고르세요. 다른 방법은 나중에 언제든 사용할 수 있습니다.</string>
  <string name="onboarding_use_download">%1$s에서 다운로드</string>
  <string name="onboarding_use_download_ios">Ketch가 백그라운드에 있으면 다운로드가 일시정지될 수 있습니다.</string>
  <string name="onboarding_use_download_android">다른 앱을 사용하는 동안에도 다운로드가 계속됩니다.</string>
  <string name="onboarding_use_control">컴퓨터 제어</string>
  <string name="onboarding_use_control_body">여기에서 컴퓨터의 Ketch에 다운로드를 추가합니다.</string>
  <string name="onboarding_recommended">추천</string>

  <string name="onboarding_intake_title">Ketch로 링크 보내기</string>
  <string name="onboarding_intake_body">이미 사용 중인 앱에서 다운로드를 시작하세요.</string>
  <string name="onboarding_intake_start">다운로드 시작</string>
  <string name="onboarding_intake_share">브라우저에서 공유</string>
  <string name="onboarding_intake_share_body">공유를 탭한 다음 Ketch를 선택하세요. 페이지를 벗어나지 않고 다운로드가 시작됩니다.</string>
  <string name="onboarding_intake_select">링크 선택</string>
  <string name="onboarding_intake_select_body">텍스트를 선택하면 나타나는 메뉴에서 Ketch로 다운로드를 선택하세요.</string>
  <string name="onboarding_intake_copy">링크 복사</string>
  <string name="onboarding_intake_copy_body">Ketch로 돌아오면 링크를 다운로드할지 물어봅니다.</string>
  <string name="onboarding_intake_torrents">마그넷 링크 및 .torrent 파일 열기</string>

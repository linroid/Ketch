<?xml version="1.0" encoding="utf-8"?>
<resources>
  <string name="onboarding_step">第 %1$d 步，共 %2$d 步</string>
  <string name="onboarding_loading">正在載入 Ketch</string>

  <string name="onboarding_files_title">你的下載項目，就在「檔案」中</string>
  <string name="onboarding_files_body">下載的檔案會儲存在 Ketch 資料夾中，可透過「檔案」App 開啟、分享或移動。</string>
  <string name="onboarding_files_path">我的 %1$s › Ketch › Downloads</string>

  <string name="onboarding_folder_title">要將下載項目存到哪裡？</string>
  <string name="onboarding_folder_body">其他應用程式無法存取 Ketch 的專用資料夾。儲存到「Download」資料夾後，就能在其他應用程式中存取下載的檔案。</string>
  <string name="onboarding_folder_use_download">使用「Download」資料夾</string>
  <string name="onboarding_folder_not_now">暫時不要</string>
  <string name="onboarding_folder_choose_another">選擇其他資料夾</string>
  <string name="onboarding_folder_saving_to">將儲存至 %1$s</string>
  <string name="onboarding_folder_torrents">透過種子下載的檔案仍會儲存在 Ketch 資料夾中。</string>
  <string name="onboarding_folder_error">無法使用該資料夾，請試試其他資料夾。</string>

  <string name="onboarding_use_title">想如何使用 Ketch？</string>
  <string name="onboarding_use_body">先選一種使用方式，之後隨時都能使用另一種。</string>
  <string name="onboarding_use_download">在%1$s上下載</string>
  <string name="onboarding_use_download_ios">Ketch 在背景執行時，下載可能會暫停。</string>
  <string name="onboarding_use_download_android">使用其他應用程式時，下載會繼續進行。</string>
  <string name="onboarding_use_control">控制電腦</string>
  <string name="onboarding_use_control_body">從這裡將下載新增到電腦上的 Ketch。</string>
  <string name="onboarding_recommended">建議</string>

  <string name="onboarding_intake_title">將連結傳送到 Ketch</string>
  <string name="onboarding_intake_body">從你常用的應用程式開始下載。</string>
  <string name="onboarding_intake_start">開始下載</string>
  <string name="onboarding_intake_share">從瀏覽器分享</string>
  <string name="onboarding_intake_share_body">點一下「分享」，再點「Ketch」。不必離開網頁就會開始下載。</string>
  <string name="onboarding_intake_select">選取連結</string>
  <string name="onboarding_intake_select_body">選取文字後，在顯示的選單中選擇「使用 Ketch 下載」。</string>
  <string name="onboarding_intake_copy">複製連結</string>
  <string name="onboarding_intake_copy_body">返回 Ketch 後，會詢問是否下載該連結的內容。</string>
  <string name="onboarding_intake_torrents">開啟磁力連結和 .torrent 檔案</string>
  <string name="onboarding_intake_torrents_body">它們會在 Ketch 中開啟，讓你選擇想要的檔案。</string>
  <string name="onboarding_intake_notify">下載完成時收到通知</string>
  <string name="onboarding_intake_notify_body">Ketch 會在下載完成或失敗時通知你；可在「設定」中選擇要通知的事項。</string>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The Connections page: every live network connection of the shown devices, as a table on wide
  windows and as rows on narrow ones. See docs/development/localization.md.
-->
<resources>
  <!-- The search field over the table. -->
  <string name="connections_search">Search endpoints, tasks and protocols</string>
  <!-- The filter chip that shows the connections of every protocol. -->
  <string name="connections_filter_all">All</string>
  <!-- Column headers. Where a connection goes, such as "example.org:443" or a peer's IP. -->
  <string name="connections_column_endpoint">Endpoint</string>
  <string name="connections_column_device">Device</string>
  <!-- The download the connection is for. -->
  <string name="connections_column_task">Task</string>
  <string name="connections_column_protocol">Protocol</string>
  <!-- How it reaches its endpoint: directly, through a proxy, or a peer that connected in. -->
  <string name="connections_column_route">Route</string>
  <!-- A BitTorrent peer's state. -->
  <string name="connections_column_peer">Peer</string>
  <string name="connections_column_client">Client</string>
  <!-- Speeds now: received ("Down") and sent ("Up"). -->
  <string name="connections_column_down">Down</string>
  <string name="connections_column_up">Up</string>
  <!-- Bytes received and sent since it opened. -->
  <string name="connections_column_received">Received</string>
  <string name="connections_column_sent">Sent</string>
  <!-- How long it has been open. -->
  <string name="connections_column_open">Open</string>
  <!-- Route column values. -->
  <string name="connections_route_direct">Direct</string>
  <string name="connections_route_http_proxy">HTTP proxy</string>
  <string name="connections_route_socks_proxy">SOCKS5 proxy</string>
  <!-- Peer column values: the peer sends no data to this device for now, or may. -->
  <string name="connections_peer_choked">Choked</string>
  <string name="connections_peer_unchoked">Unchoked</string>
  <!-- After the peer's state: this device sends data to the peer. -->
  <string name="connections_peer_uploading">Uploading</string>
  <!-- In a connection's details, after the peer's state: the peer wants pieces this device has. -->
  <string name="connections_peer_interested">Interested</string>
  <!-- Under a connection's details on hover: the task cell of the row opens the task. -->
  <string name="connections_detail_hint">Click the task to show it in Downloads.</string>
  <!-- Accessibility labels of a list row, which opens and closes its details when tapped. -->
  <string name="connections_show_details">Show details</string>
  <string name="connections_hide_details">Hide details</string>
  <!-- Shown while nothing is connected. -->
  <string name="connections_empty_body">Connections show here while downloads run or torrents seed.</string>
  <string name="connections_no_match">No connections match</string>
  <!-- Shown when the shown device runs a Ketch too old to report connections. -->
  <string name="connections_unsupported_title">This device doesn't report its connections</string>
  <string name="connections_unsupported_body">Update Ketch on that device to see them here.</string>
  <!-- Under the list: connections left out, as only the fastest are listed. -->
  <plurals name="connections_more">
    <item quantity="one">%1$d slower connection isn't listed</item>
    <item quantity="other">%1$d slower connections aren't listed</item>
  </plurals>
  <!-- Under the list, beside the button that downloads the database the endpoints' flags come from. -->
  <string name="connections_countries_hint">Show each endpoint's country with a flag. Downloads DB-IP's free database (about 5 MB).</string>
  <string name="connections_countries_download">Show countries</string>
  <string name="connections_countries_failed">Couldn't get the country database: %1$s</string>
  <!-- The attribution the database's licence (CC BY 4.0) asks for. -->
  <string name="connections_countries_attribution">IP geolocation by DB-IP (db-ip.com)</string>
  <!-- The switch beside the protocol chips: connections still open, ones that closed lately, or both. -->
  <string name="connections_status_open">Open</string>
  <string name="connections_status_closed">Closed</string>
  <!-- In a closed connection's details, after "Closed": how long ago it closed, such as "2m 5s ago". -->
  <string name="connections_closed_ago">%1$s ago</string>
  <!-- A closed connection's row, in place of its speeds: how long ago it closed. -->
  <string name="connections_row_closed">Closed %1$s ago</string>
  <!-- In a closed connection's details: how long it was open. -->
  <string name="connections_detail_was_open">Was open</string>
  <!-- After the page's summary: bytes every connection received and sent since the device started. -->
  <string name="connections_total_received">%1$s received</string>
  <string name="connections_total_sent">%1$s sent</string>
</resources>

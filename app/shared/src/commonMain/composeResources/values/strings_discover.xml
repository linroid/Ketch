  <!-- The page before Discover is set up. -->
  <string name="discover_setup_body">Discover uses an AI model to search the web and list the downloads it finds. Your searches go to the provider you choose.</string>
  <string name="discover_setup_unsupported">Discover runs in the Ketch app on a computer or an Android phone.</string>
  <!-- %1$s is the search the user asked for before setting up. -->
  <string name="discover_setup_pending">“%1$s” runs once Discover is set up.</string>
  <string name="discover_setup_choose_model">Choose a model</string>
  <!-- A provider's button. %1$s is Ollama, which runs on the user's own computer. -->
  <string name="discover_setup_local_provider">%1$s · runs locally, no key</string>
  <!-- %1$s is the provider picked, such as OpenAI. -->
  <string name="discover_setup_finish">Finish setting up %1$s</string>
  <string name="discover_setup_in_settings">Set up in Settings</string>
  <!-- A model server that speaks OpenAI's API, set up in Settings; OpenAI is a name. -->
  <string name="discover_provider_openai_compatible">OpenAI-compatible</string>

  <!-- The composer at the bottom of a chat. Its placeholder in a new chat, then in one with messages. -->
  <string name="discover_query_placeholder">Describe what to find…</string>
  <string name="discover_follow_up_placeholder">Ask a follow-up…</string>
  <!-- The composer's button: Find sends a chat's first message, Send its follow-ups. -->
  <string name="discover_find">Find</string>
  <string name="discover_send">Send</string>
  <string name="discover_stop">Stop</string>
  <string name="discover_sites_limit">Limit to websites</string>
  <!-- The website chip while two or more websites limit the search. -->
  <plurals name="discover_sites_count">
    <item quantity="one">%1$d website</item>
    <item quantity="other">%1$d websites</item>
  </plurals>
  <!-- Under the website field, which splits the websites at commas and spaces. -->
  <string name="discover_sites_hint">Searches only these websites and their subdomains. Separate them with commas.</string>

  <!-- The agent's steps. Before them, how many earlier steps are hidden. -->
  <plurals name="discover_steps_earlier">
    <item quantity="one">%1$d earlier</item>
    <item quantity="other">%1$d earlier</item>
  </plurals>
  <string name="discover_step_starting">Starting the search</string>
  <!-- Folds open, under the steps, a list of every step with all the agent said about it. -->
  <string name="discover_steps_details">Details</string>

  <!-- The chat. Under a message limited to websites; %1$s lists them, such as "blender.org, github.com". -->
  <string name="discover_limited_to">Limited to %1$s</string>
  <!-- A message that waits while other chats search. -->
  <string name="discover_queued">Waiting for another search to finish</string>
  <!-- Folds the agent's reply open or closed when it is long. -->
  <string name="discover_show_more">Show more</string>
  <string name="discover_show_less">Show less</string>
  <!-- How the user answered the agent's requests to open websites during a message, joined by " · ". -->
  <plurals name="discover_access_allowed">
    <item quantity="one">Allowed %1$d site</item>
    <item quantity="other">Allowed %1$d sites</item>
  </plurals>
  <plurals name="discover_access_denied">
    <item quantity="one">Denied %1$d site</item>
    <item quantity="other">Denied %1$d sites</item>
  </plurals>
  <!-- One line each under the answers above. %1$s is a website, such as download.blender.org. -->
  <string name="discover_access_allowed_host">Allowed %1$s</string>
  <string name="discover_access_denied_host">Denied %1$s</string>

  <!-- The card that asks before the agent opens a website. %1$s is the website, such as download.blender.org. -->
  <string name="discover_approval_page">Open %1$s?</string>
  <!-- The agent wants to check a file's type and size on the website. -->
  <string name="discover_approval_file">Check a file on %1$s?</string>
  <!-- A website the agent opened sends it on to this one. -->
  <string name="discover_approval_redirect">Follow a redirect to %1$s?</string>

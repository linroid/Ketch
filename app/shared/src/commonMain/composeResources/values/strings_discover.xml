  <string name="discover_approval_redirect_from">Redirected from %1$s</string>
  <!-- Why the agent says it needs the website, in its own words. %1$s is that reason. -->
  <string name="discover_approval_reason">Discover says: %1$s</string>
  <string name="discover_approval_allow">Allow</string>
  <string name="discover_approval_allow_once">Allow once</string>
  <string name="discover_approval_deny">Deny</string>
  <!-- %1$s is a site, such as blender.org, which covers its subdomains. -->
  <string name="discover_approval_always">Always allow %1$s</string>
  <string name="discover_approval_allow_site">Allow %1$s in this chat</string>
  <string name="discover_approval_allow_all">Allow all sites in this chat</string>

<!--
  How a download's row, its actions and the status tabs describe a task. See
  docs/development/localization.md.
-->
<resources>
  <!-- Status tabs of the Downloads page. -->
  <string name="status_tab_all">All</string>
  <string name="status_tab_downloading">Downloading</string>
  <string name="status_tab_waiting">Waiting</string>

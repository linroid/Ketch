  <!-- A task's status in a word or two, in its row. -->
  <string name="row_status_downloading">Downloading</string>
  <string name="row_status_stalled">Stalled</string>
  <string name="row_status_paused">Paused</string>
  <!-- A queued task that holds a download slot and is getting ready, such as a magnet link looking up its torrent. -->
  <string name="row_status_starting">Starting</string>
  <string name="row_status_queued">Queued</string>
  <string name="row_status_scheduled">Scheduled</string>
  <string name="row_status_done">Done</string>
  <string name="row_status_file_missing">File missing</string>
  <string name="row_status_failed">Failed</string>
  <string name="row_status_canceled">Canceled</string>

  <!-- Details of a row, joined by " · ". %1$s is a duration, such as "12s". -->
  <string name="row_stalled_for">Stalled · no data for %1$s</string>
  <string name="row_paused">Paused</string>
  <string name="row_canceled">Canceled</string>

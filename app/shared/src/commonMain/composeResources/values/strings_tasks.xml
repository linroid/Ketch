  <string name="row_saved_on">Saved on %1$s</string>
  <string name="row_missing_file">File moved or deleted</string>
  <string name="row_completed">Completed</string>
  <!-- How long a finished download took. %1$s is a duration, such as "4m 2s". -->
  <string name="row_took">took %1$s</string>
  <plurals name="row_files">
    <item quantity="one">%1$d file</item>
    <item quantity="other">%1$d files</item>
  </plurals>
  <plurals name="row_connections">
    <item quantity="one">%1$d connection</item>
    <item quantity="other">%1$d connections</item>
  </plurals>
  <!-- A task's own speed limit. %1$s is a speed, such as "2 MB/s". -->
  <string name="row_speed_limit">limit %1$s</string>
  <!-- Follows other details after " · ", so it starts in lower case in English. -->
  <string name="row_limited_by_slow_lane">limited by Slow lane</string>
  <!-- %1$s is a time of day, such as 09:05. -->
  <string name="row_starts_today">Starts today at %1$s</string>
  <string name="row_starts_tomorrow">Starts tomorrow at %1$s</string>

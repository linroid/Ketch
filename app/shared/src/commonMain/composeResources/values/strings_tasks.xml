  <string name="row_starts_in">in %1$s</string>
  <string name="row_starts_after">Starts after %1$s</string>
  <string name="row_waiting_for_conditions">Waiting for conditions</string>
  <!-- A paused task's detail when the engine paused it for an urgent download. -->
  <string name="row_paused_preempted">Paused for an urgent download · resumes automatically</string>
  <!-- A paused task's detail when its device's Ketch closed while it downloaded. -->
  <string name="row_paused_shutdown">Paused when Ketch closed · resumes when it starts</string>

